# Copy this file to ".env" and fill in your real values.
# Get API_ID and API_HASH from https://my.telegram.org -> "API development tools"
# (log in with the Telegram account you want to monitor with, create an app,
# and it will show you the api_id and api_hash).

TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=your_api_hash_here

# The chat to monitor. Run `python main.py --list-chats` after your first
# login to print all your dialogs with their numeric IDs, then paste the
# correct ID here (it can be negative for groups/channels).
TELEGRAM_CHAT_ID=-1001234567890

# Name used for the Telethon .session file (keep this private, see README).
TELEGRAM_SESSION_NAME=bdv_monitor

# Comma-separated bank codes to watch for. Codes must match the first
# column of bancos.txt (case-insensitive), e.g. BDV,BBVA,BNC
TARGET_BANK_CODES=BDV
